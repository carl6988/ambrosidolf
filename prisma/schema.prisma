// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  REEL
  PHOTO
  CAROUSEL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Only admins can create/remove other users (the "Team" page).
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Creator {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  accounts         Account[]
  managementFields CreatorManagementField[]
  recoveryAccounts CreatorRecoveryAccount[]
  phoneLogins      CreatorPhoneLogin[]
}

// An account currently banned/suspended and working through recovery —
// tracked separately from Account because it's often not (or no longer) a
// trackable Instagram profile, just a name + status note.
model CreatorRecoveryAccount {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  username  String
  note      String?
  createdAt DateTime @default(now())

  @@index([creatorId])
}

// One row per physical device used to manage a Creator's accounts — mirrors
// the team's existing "Login Overview" spreadsheet. Credentials are stored
// as plain text (same as the spreadsheet today) since this is an internal
// ops reference, not an auth mechanism; the page only masks them by default.
model CreatorPhoneLogin {
  id                  String   @id @default(cuid())
  creatorId           String
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  phoneLabel          String
  phoneNumber         String?
  phoneOwner          String?
  media               String?
  accountUsername     String?
  accountPassword     String?
  gmailAppleId        String?
  gmailApplePassword  String?
  gmailCreatedOnPhone String?
  simPin              String?
  note                String?
  createdAt           DateTime @default(now())

  @@index([creatorId])
}

// Free-form cells for the per-Creator "Management Overview" sheet (Instagram
// account health, content capacity, ...). One row per fixed field key (see
// MANAGEMENT_FIELDS in app/creators/[id]/management/fields.ts) — value/
// accountNames/note are plain text since some rows hold non-numeric answers
// (e.g. "Maybe with Editor").
model CreatorManagementField {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  key          String
  value        String?
  accountNames String?
  note         String?
  updatedAt    DateTime @updatedAt

  @@unique([creatorId, key])
}

model Account {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  username    String   @unique
  displayName String
  profileUrl  String
  createdAt   DateTime @default(now())

  // SLT.bio link-in-bio integration — the connected page's slug, used to
  // match incoming /v1/events against this account.
  sltBioPageSlug String?

  // Set on the Creator Management Overview page. Feeds the "Soll" side of
  // the Posts stat card on the account/Creator overview pages (target =
  // dailyPostsPlan × days in the selected range).
  dailyPostsPlan Int     @default(0)
  notes          String?

  posts        Post[]
  dailyMetrics AccountDailyMetric[]
  linkClicks   LinkClickImport[]

  @@index([creatorId])
}

model Post {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalPostId String?
  url            String
  caption        String?
  mediaType      MediaType
  postedAt       DateTime
  thumbnailUrl   String?
  createdAt      DateTime  @default(now())

  dailyMetrics PostDailyMetric[]
  linkClicks   LinkClickImport[]

  @@unique([accountId, externalPostId])
  @@index([accountId])
}

model PostDailyMetric {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  date     DateTime
  views    Int
  likes    Int
  comments Int
  // Instagram doesn't expose these publicly (scraping APIs included) — only
  // the account owner sees them in their own Insights. Left nullable so an
  // API sync can populate views/likes/comments without having to fake these.
  shares   Int?
  saves    Int?

  @@unique([postId, date])
}

model AccountDailyMetric {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date       DateTime
  followers  Int
  totalViews Int?

  @@unique([accountId, date])
}

model LinkClickImport {
  id           String   @id @default(cuid())
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  date         DateTime
  clicks       Int
  uniqueClicks Int?
  source       String   @default("slt.bio")
  rawPayload   String?
  importedAt   DateTime @default(now())

  @@unique([accountId, date, source])
  @@index([accountId])
  @@index([postId])
}
